+def _get_console_display():
+  """Return the display number of the user's gdm-managed console X server.
+
+  The gdm login session runs an X server owned by the logged-in user with
+  authority from '/run/user/<uid>/gdm/Xauthority'. Probe candidate displays
+  and return the first one that responds to that authority.
+  """
+  xauth = "/run/user/%d/gdm/Xauthority" % os.getuid()
+  if os.path.exists(xauth):
+    for num in range(16):
+      env = dict(os.environ)
+      env["DISPLAY"] = ":%d" % num
+      env["XAUTHORITY"] = xauth
+      try:
+        exit_code = subprocess.call("xdpyinfo", env=env,
+                                    stdout=subprocess.DEVNULL,
+                                    stderr=subprocess.DEVNULL)
+        if exit_code == 0:
+          return ":%d" % num
+      except OSError:
+        break
+  # Fall back to the most common console display.
+  return ":1"
+
