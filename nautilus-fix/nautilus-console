#!/usr/bin/env bash
# Launches GNOME Files against the console (gdm-managed) X session.
# Detects the display dynamically so it survives display-number changes.
set -u

xauth="/run/user/$(id -u)/gdm/Xauthority"

if [ -r "$xauth" ]; then
  for d in $(seq 0 15); do
    if DISPLAY=:$d XAUTHORITY="$xauth" xdpyinfo >/dev/null 2>&1; then
      export DISPLAY=:$d
      export XAUTHORITY="$xauth"
      break
    fi
  done
fi

exec /usr/bin/nautilus --gapplication-service
